ninja_required_version = 1.3
cxx = /usr/local/gcc/gcc-8.2/bin/g++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -Wno-unused-result -Wsign-compare -DDYNAMIC_ANNOTATIONS_ENABLED=1 -DNDEBUG -O2 -fexceptions -g -grecord-gcc-switches -pipe -Wall -Werror=format-security -Wp,-D_FORTIFY_SOURCE=2 -Wp,-D_GLIBCXX_ASSERTIONS -fstack-protector-strong -m64 -mtune=generic -fasynchronous-unwind-tables -fstack-clash-protection -fcf-protection -D_GNU_SOURCE -fPIC -fwrapv -O2 -fexceptions -g -grecord-gcc-switches -pipe -Wall -Werror=format-security -Wp,-D_FORTIFY_SOURCE=2 -Wp,-D_GLIBCXX_ASSERTIONS -fstack-protector-strong -m64 -mtune=generic -fasynchronous-unwind-tables -fstack-clash-protection -fcf-protection -D_GNU_SOURCE -fPIC -fwrapv -O2 -fexceptions -g -grecord-gcc-switches -pipe -Wall -Werror=format-security -Wp,-D_FORTIFY_SOURCE=2 -Wp,-D_GLIBCXX_ASSERTIONS -fstack-protector-strong -m64 -mtune=generic -fasynchronous-unwind-tables -fstack-clash-protection -fcf-protection -D_GNU_SOURCE -fPIC -fwrapv -fPIC -I/home/bauerkn/pcfa-lounge/lib64/python3.9/site-packages/torch/include -I/home/bauerkn/pcfa-lounge/lib64/python3.9/site-packages/torch/include/torch/csrc/api/include -I/home/bauerkn/pcfa-lounge/lib64/python3.9/site-packages/torch/include/TH -I/home/bauerkn/pcfa-lounge/lib64/python3.9/site-packages/torch/include/THC -I/usr/local/cuda/include -I/home/bauerkn/pcfa-lounge/include -I/usr/include/python3.9 -c
post_cflags = -g -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=value_aggregation_cuda -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++14
cuda_cflags = -I/home/bauerkn/pcfa-lounge/lib64/python3.9/site-packages/torch/include -I/home/bauerkn/pcfa-lounge/lib64/python3.9/site-packages/torch/include/torch/csrc/api/include -I/home/bauerkn/pcfa-lounge/lib64/python3.9/site-packages/torch/include/TH -I/home/bauerkn/pcfa-lounge/lib64/python3.9/site-packages/torch/include/THC -I/usr/local/cuda/include -I/home/bauerkn/pcfa-lounge/include -I/usr/include/python3.9 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O2 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=value_aggregation_cuda -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_75,code=compute_75 -gencode=arch=compute_75,code=sm_75 -ccbin /usr/local/gcc/gcc-8.2/bin/gcc -std=c++14
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags



build /home/bauerkn/model_repos/MatchFlow/QuadTreeAttention/build/temp.linux-x86_64-3.9/QuadtreeAttention/src/value_aggregation.o: compile /home/bauerkn/model_repos/MatchFlow/QuadTreeAttention/QuadtreeAttention/src/value_aggregation.cpp
build /home/bauerkn/model_repos/MatchFlow/QuadTreeAttention/build/temp.linux-x86_64-3.9/QuadtreeAttention/src/value_aggregation_kernel.o: cuda_compile /home/bauerkn/model_repos/MatchFlow/QuadTreeAttention/QuadtreeAttention/src/value_aggregation_kernel.cu





